#include <winver.h>

/* UTF-8 + long path awareness, see jcat-tool.manifest */
1 RT_MANIFEST "jcat-tool.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @JCAT_MAJOR_VERSION@,@JCAT_MINOR_VERSION@,@JCAT_MICRO_VERSION@,0
  PRODUCTVERSION @JCAT_MAJOR_VERSION@,@JCAT_MINOR_VERSION@,@JCAT_MICRO_VERSION@,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS      VS_FF_DEBUG
#else
  FILEFLAGS      0x0L
#endif
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0" /* US English, Unicode */
    BEGIN
      VALUE "CompanyName",      "The libjcat project\0"
      VALUE "FileDescription",  "JSON Catalog Utility\0"
      VALUE "FileVersion",      @PACKAGE_VERSION@ "\0"
      VALUE "InternalName",     "jcat-tool\0"
      VALUE "LegalCopyright",   "Licensed under LGPL-2.1-or-later\0"
      VALUE "OriginalFilename", "jcat-tool.exe\0"
      VALUE "ProductName",      "libjcat\0"
      VALUE "ProductVersion",   @PACKAGE_VERSION@ "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x04B0
  END
END
